                textBox.TextXAlignment = Enum.TextXAlignment.Left
                textBox.ClearTextOnFocus = false
                textBox.Parent = inputFrame

                textBox.FocusLost:Connect(function(enterPressed)
                    if enterPressed and callback then
                        local success, err = pcall(function()
                            callback(textBox.Text)
                        end)
                        if not success then
                            warn("Error in text input callback: " .. err)
                        end
                    end
                end)

                function SectionObject:GetTextInputValue()
                    return textBox.Text
                end

                tabData.YPosition = currentY + 95
                tabData.Frame.CanvasSize = UDim2.new(0, 0, 0, tabData.YPosition + 10)
            end

            function SectionObject:NewInputToggle(inputName, description, callback)
                local currentY = tabData.YPosition
                local inputToggleId = tostring(math.random(10000, 99999))

                local inputToggleFrame = Instance.new("Frame")
                inputToggleFrame.Size = UDim2.new(1, 0, 0, 85)
                inputToggleFrame.Position = UDim2.new(0, 0, 0, currentY)
                inputToggleFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- Черный фон
                inputToggleFrame.BorderSizePixel = 1
                inputToggleFrame.BorderColor3 = CurrentColor -- Цветная обводка
                inputToggleFrame.Parent = container

                local nameLabel = Instance.new("TextLabel")
                nameLabel.Size = UDim2.new(1, -80, 0, 20)
                nameLabel.Position = UDim2.new(0, 10, 0, 8)
                nameLabel.BackgroundTransparency = 1
                nameLabel.Text = inputName
                nameLabel.TextColor3 = CurrentColor -- Цветной текст
                nameLabel.TextSize = 16
                nameLabel.Font = Enum.Font.Code
                nameLabel.TextXAlignment = Enum.TextXAlignment.Left
                nameLabel.Parent = inputToggleFrame

                local descLabel = Instance.new("TextLabel")
                descLabel.Size = UDim2.new(1, -80, 0, 16)
                descLabel.Position = UDim2.new(0, 10, 0, 28)
                descLabel.BackgroundTransparency = 1
                descLabel.Text = description or ""
                descLabel.TextColor3 = Color3.fromRGB(140, 140, 140)
                descLabel.TextSize = 12
                descLabel.Font = Enum.Font.Code
                descLabel.TextXAlignment = Enum.TextXAlignment.Left
                descLabel.Parent = inputToggleFrame

                local toggleBg = Instance.new("Frame")
                toggleBg.Size = UDim2.new(0, 50, 0, 24)
                toggleBg.Position = UDim2.new(1, -60, 0, 6)
                toggleBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                toggleBg.BorderSizePixel = 1
                toggleBg.BorderColor3 = CurrentColor -- Цветная обводка
                toggleBg.Parent = inputToggleFrame

                local toggleIndicator = Instance.new("Frame")
                toggleIndicator.Size = UDim2.new(0, 20, 0, 16)
                toggleIndicator.Position = UDim2.new(0, 2, 0.5, -8)
                toggleIndicator.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
                toggleIndicator.BorderSizePixel = 1
                toggleIndicator.BorderColor3 = CurrentColor -- Цветная обводка
                toggleIndicator.Parent = toggleBg

                local textBox = Instance.new("TextBox")
                textBox.Size = UDim2.new(1, -20, 0, 30)
                textBox.Position = UDim2.new(0, 10, 0, 48)
                textBox.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- Черный фон
                textBox.BorderSizePixel = 1
                textBox.BorderColor3 = CurrentColor -- Цветная обводка
                textBox.Text = ""
                textBox.PlaceholderText = "Enter text..."
                textBox.PlaceholderColor3 = Color3.fromRGB(100, 100, 100)
                textBox.TextColor3 = CurrentColor -- Цветной текст
                textBox.TextSize = 14
                textBox.Font = Enum.Font.Code
                textBox.TextXAlignment = Enum.TextXAlignment.Left
                textBox.ClearTextOnFocus = false
                textBox.TextEditable = true
                textBox.Parent = inputToggleFrame

                local toggleState = false
                InputToggleStates[inputToggleId] = {state = false, text = ""}

                local function updateToggle()
                    if toggleState then
                        toggleIndicator.BackgroundColor3 = CurrentColor -- Цветной индикатор
                        toggleIndicator.Position = UDim2.new(1, -22, 0.5, -8)
                    else
                        toggleIndicator.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
                        toggleIndicator.Position = UDim2.new(0, 2, 0.5, -8)
                    end
                end

                local toggleButton = Instance.new("TextButton")
                toggleButton.Size = UDim2.new(0, 50, 0, 24)
                toggleButton.Position = UDim2.new(1, -60, 0, 6)
                toggleButton.BackgroundTransparency = 1
                toggleButton.Text = ""
                toggleButton.ZIndex = 2
                toggleButton.Parent = inputToggleFrame

                toggleButton.MouseButton1Click:Connect(function()
                    toggleState = not toggleState
                    InputToggleStates[inputToggleId] = {state = toggleState, text = textBox.Text}
                    updateToggle()
                    if callback then
                        local success, err = pcall(function()
                            callback(textBox, toggleState)
                        end)
                        if not success then
                            warn("Error in input toggle callback: " .. err)
                        end
                    end
                end)

                updateToggle()

                function SectionObject:GetInputToggleState()
                    return toggleState, textBox.Text
                end

                tabData.YPosition = currentY + 95
                tabData.Frame.CanvasSize = UDim2.new(0, 0, 0, tabData.YPosition + 10)
            end

            function SectionObject:NewChat(chatName, description)
                local currentY = tabData.YPosition

                local chatFrame = Instance.new("Frame")
                chatFrame.Size = UDim2.new(1, 0, 0, 300)
                chatFrame.Position = UDim2.new(0, 0, 0, currentY)
                chatFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- Черный фон
                chatFrame.BorderSizePixel = 1
                chatFrame.BorderColor3 = CurrentColor -- Цветная обводка
                chatFrame.Parent = container

                local nameLabel = Instance.new("TextLabel")
                nameLabel.Size = UDim2.new(1, -20, 0, 20)
                nameLabel.Position = UDim2.new(0, 10, 0, 8)
                nameLabel.BackgroundTransparency = 1
                nameLabel.Text = chatName
                nameLabel.TextColor3 = CurrentColor -- Цветной текст
                nameLabel.TextSize = 16
                nameLabel.Font = Enum.Font.Code
                nameLabel.TextXAlignment = Enum.TextXAlignment.Left
                nameLabel.Parent = chatFrame

                local descLabel = Instance.new("TextLabel")
                descLabel.Size = UDim2.new(1, -20, 0, 16)
                descLabel.Position = UDim2.new(0, 10, 0, 28)
                descLabel.BackgroundTransparency = 1
                descLabel.Text = description or ""
                descLabel.TextColor3 = Color3.fromRGB(140, 140, 140)
                descLabel.TextSize = 12
                descLabel.Font = Enum.Font.Code
                descLabel.TextXAlignment = Enum.TextXAlignment.Left
                descLabel.Parent = chatFrame

                local messagesFrame = Instance.new("ScrollingFrame")
                messagesFrame.Size = UDim2.new(1, -20, 0, 170)
                messagesFrame.Position = UDim2.new(0, 10, 0, 48)
                messagesFrame.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
                messagesFrame.BorderSizePixel = 1
                messagesFrame.BorderColor3 = CurrentColor -- Цветная обводка
                messagesFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
                messagesFrame.ScrollBarThickness = 6
                messagesFrame.ScrollBarImageColor3 = CurrentColor -- Цветной скроллбар
                messagesFrame.Parent = chatFrame

                local messagesList = Instance.new("UIListLayout")
                messagesList.FillDirection = Enum.FillDirection.Vertical
                messagesList.SortOrder = Enum.SortOrder.LayoutOrder
                messagesList.Padding = UDim.new(0, 4)
                messagesList.Parent = messagesFrame

                local messagesPadding = Instance.new("UIPadding")
                messagesPadding.PaddingLeft = UDim.new(0, 5)
                messagesPadding.PaddingRight = UDim.new(0, 5)
                messagesPadding.PaddingTop = UDim.new(0, 5)
                messagesPadding.PaddingBottom = UDim.new(0, 5)
                messagesPadding.Parent = messagesFrame

                local nickBox = Instance.new("TextBox")
                nickBox.Size = UDim2.new(0.25, -5, 0, 26)
                nickBox.Position = UDim2.new(0, 10, 0, 225)
                nickBox.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- Черный фон
                nickBox.BorderSizePixel = 1
                nickBox.BorderColor3 = CurrentColor -- Цветная обводка
                nickBox.Text = ""
                nickBox.PlaceholderText = "Nickname"
                nickBox.PlaceholderColor3 = Color3.fromRGB(100, 100, 100)
                nickBox.TextColor3 = CurrentColor -- Цветной текст
                nickBox.TextSize = 14
                nickBox.Font = Enum.Font.Code
                nickBox.TextXAlignment = Enum.TextXAlignment.Left
                nickBox.ClearTextOnFocus = false
                nickBox.Parent = chatFrame

                local messageBox = Instance.new("TextBox")
                messageBox.Size = UDim2.new(0.55, -10, 0, 26)
                messageBox.Position = UDim2.new(0.25, 15, 0, 225)
                messageBox.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- Черный фон
                messageBox.BorderSizePixel = 1
                messageBox.BorderColor3 = CurrentColor -- Цветная обводка
                messageBox.Text = ""
                messageBox.PlaceholderText = "Message"
                messageBox.PlaceholderColor3 = Color3.fromRGB(100, 100, 100)
                messageBox.TextColor3 = CurrentColor -- Цветной текст
                messageBox.TextSize = 14
                messageBox.Font = Enum.Font.Code
                messageBox.TextXAlignment = Enum.TextXAlignment.Left
                messageBox.ClearTextOnFocus = false
                messageBox.Parent = chatFrame

                local sendButton = Instance.new("TextButton")
                sendButton.Size = UDim2.new(0.2, -10, 0, 26)
                sendButton.Position = UDim2.new(0.8, 10, 0, 225)
                sendButton.BackgroundColor3 = CurrentColor -- Цветной фон для кнопки SEND
                sendButton.BorderSizePixel = 0
                sendButton.Text = "SEND"
                sendButton.TextColor3 = Color3.fromRGB(0, 0, 0) -- Черный текст на цветном фоне
                sendButton.TextSize = 14
                sendButton.Font = Enum.Font.Code
                sendButton.Parent = chatFrame

                local messages = {}

                local function addMessage(nick, msg)
                    local isSelf = (nick == nickBox.Text)
                    local color = isSelf and CurrentColor or Color3.fromRGB(180, 180, 180)
                    
                    local msgFrame = Instance.new("Frame")
                    msgFrame.Size = UDim2.new(1, 0, 0, 0)
                    msgFrame.BackgroundTransparency = 1
                    msgFrame.Parent = messagesFrame

                    local msgLabel = Instance.new("TextLabel")
                    msgLabel.Size = UDim2.new(1, 0, 0, 18)
                    msgLabel.BackgroundTransparency = 1
                    msgLabel.Text = "[" .. os.date("%H:%M:%S") .. "] " .. nick .. ": " .. msg
                    msgLabel.TextColor3 = color
                    msgLabel.TextSize = 13
                    msgLabel.Font = Enum.Font.Code
                    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
                    msgLabel.TextWrapped = true
                    msgLabel.Parent = msgFrame

                    local textBounds = TextService:GetTextSize(
                        msgLabel.Text,
                        msgLabel.TextSize,
                        msgLabel.Font,
                        Vector2.new(messagesFrame.AbsoluteSize.X - 20, math.huge)
                    )
                    msgLabel.Size = UDim2.new(1, 0, 0, textBounds.Y)
                    msgFrame.Size = UDim2.new(1, 0, 0, textBounds.Y + 2)

                    table.insert(messages, msgFrame)

                    if #messages > 50 then
                        messages[1]:Destroy()
                        table.remove(messages, 1)
                    end

                    local totalHeight = 0
                    for _, frame in ipairs(messages) do
                        totalHeight = totalHeight + frame.Size.Y.Offset + 4
                    end
                    messagesFrame.CanvasSize = UDim2.new(0, 0, 0, totalHeight + 10)

                    messagesFrame.CanvasPosition = Vector2.new(0, messagesFrame.CanvasSize.Y.Offset)
                end

                local function sendMessage()
                    local nick = nickBox.Text
                    local msg = messageBox.Text

                    if nick ~= "" and msg ~= "" then
                        addMessage(nick, msg)
                        messageBox.Text = ""
                    elseif nick == "" then
                        addMessage("SYSTEM", "Please enter a nickname first!")
                    end
                end

                sendButton.MouseButton1Click:Connect(sendMessage)

                messageBox.FocusLost:Connect(function(enterPressed)
                    if enterPressed then
                        sendMessage()
                    end
                end)

                function SectionObject:GetMessages()
                    local msgs = {}
                    for _, frame in ipairs(messages) do
                        local label = frame:FindFirstChildOfClass("TextLabel")
                        if label then
                            table.insert(msgs, label.Text)
                        end
                    end
                    return msgs
                end

                tabData.YPosition = currentY + 310
                tabData.Frame.CanvasSize = UDim2.new(0, 0, 0, tabData.YPosition + 10)
            end

            return SectionObject
        end

        return TabObject
    end

    function Library:GetToggleState(id)
        return ToggleStates[id] or false
    end

    function Library:GetSliderValue(id)
        return SliderValues[id] or 0
    end

    function Library:GetInputToggleState(id)
        return InputToggleStates[id] or {state = false, text = ""}
    end

    return Library
end

return Library
