    function UIElements.updateTabSizes()
        local numTabs = #TabButtons
        if numTabs > 0 then
            local width = 1 / numTabs
            for _, btn in ipairs(TabButtons) do
                btn.Size = UDim2.new(width, -2, 1, -6)
            end
        end
