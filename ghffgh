    function Library:NewTab(name)
        TabCounter = TabCounter + 1
        local tabCount = TabCounter

        local tabButton = Instance.new("TextButton")
        tabButton.Name = "TabButton_" .. tabCount
        tabButton.Size = UDim2.new(0, 100, 1, -6)
        tabButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- Черный фон
        tabButton.BorderSizePixel = 1
        tabButton.BorderColor3 = CurrentColor -- Цветная обводка
        tabButton.Text = name
        tabButton.TextColor3 = (tabCount == 1) and CurrentColor or Color3.fromRGB(140, 140, 140) -- Цветной текст для активной вкладки
        tabButton.TextSize = 14
        tabButton.Font = Enum.Font.Code
        tabButton.Parent = tabContainer

        table.insert(TabButtons, tabButton)

        local section = Instance.new("ScrollingFrame")
        section.Name = name .. "Section_" .. TabCounter
        section.Size = UDim2.new(1, 0, 1, 0)
        section.Position = UDim2.new(0, 0, 0, 0)
        section.BackgroundTransparency = 1
        section.BorderSizePixel = 0
        section.CanvasSize = UDim2.new(0, 0, 0, 0)
        section.ScrollBarThickness = 8
        section.ScrollBarImageColor3 = CurrentColor -- Цветной скроллбар
        section.Parent = ColumnsFrame
        section.Visible = (tabCount == 1)

        local container = Instance.new("Frame")
        container.Name = "Container_" .. TabCounter
        container.Size = UDim2.new(1, -20, 1, -20)
        container.Position = UDim2.new(0, 10, 0, 10)
        container.BackgroundTransparency = 1
        container.Parent = section

        local tabData = {
            Frame = section,
            Container = container,
            YPosition = 0,
            Button = tabButton,
            Name = name,
            Index = TabCounter
        }

        local tabKey = name .. "_" .. TabCounter
        Sections[tabKey] = tabData
        Tabs[tabKey] = tabData

        if tabCount == 1 then
            CurrentTab = tabKey
            local line = Instance.new("Frame")
            line.Size = UDim2.new(1, 0, 0, 2)
            line.Position = UDim2.new(0, 0, 1, -2)
            line.BackgroundColor3 = CurrentColor -- Цветная линия
            line.BorderSizePixel = 0
            line.Parent = tabButton
            UIElements.ActiveLine = line
        end

        tabButton.MouseButton1Click:Connect(function()
            CurrentTab = tabKey
            for _, btn in ipairs(TabButtons) do
                btn.TextColor3 = Color3.fromRGB(140, 140, 140)
            end
            tabButton.TextColor3 = CurrentColor -- Цветной текст для активной вкладки

            if UIElements.ActiveLine then
                UIElements.ActiveLine:Destroy()
            end

            local line = Instance.new("Frame")
            line.Size = UDim2.new(1, 0, 0, 2)
            line.Position = UDim2.new(0, 0, 1, -2)
            line.BackgroundColor3 = CurrentColor -- Цветная линия
            line.BorderSizePixel = 0
            line.Parent = tabButton
            UIElements.ActiveLine = line

            for _, tab in pairs(Sections) do
                tab.Frame.Visible = false
            end
            tabData.Frame.Visible = true
        end)

        if UIElements.updateTabSizes then
            UIElements.updateTabSizes()
        end

        local TabObject = {}

        function TabObject:NewSection(sectionName)
            local SectionObject = {}
            local container = tabData.Container
            local yPos = tabData.YPosition

            local sectionTitle = Instance.new("TextLabel")
            sectionTitle.Size = UDim2.new(1, 0, 0, 30)
            sectionTitle.Position = UDim2.new(0, 0, 0, yPos)
            sectionTitle.BackgroundTransparency = 1
            sectionTitle.Text = "// " .. sectionName
            sectionTitle.TextColor3 = CurrentColor -- Цветной текст
            sectionTitle.TextSize = 16
            sectionTitle.Font = Enum.Font.Code
            sectionTitle.TextXAlignment = Enum.TextXAlignment.Left
            sectionTitle.Parent = container

            local sectionLine = Instance.new("Frame")
            sectionLine.Size = UDim2.new(1, 0, 0, 1)
            sectionLine.Position = UDim2.new(0, 0, 0, yPos + 28)
            sectionLine.BackgroundColor3 = CurrentColor -- Цветная линия
            sectionLine.BorderSizePixel = 0
            sectionLine.Parent = container

            tabData.YPosition = yPos + 40

            local function updateAllPositions()
                local startY = 40
                local children = container:GetChildren()
                local frames = {}
                for _, child in ipairs(children) do
                    if child:IsA("Frame") and child ~= sectionTitle and child ~= sectionLine then
                        table.insert(frames, child)
                    end
                end
                table.sort(frames, function(a, b)
                    return a.Position.Y.Offset < b.Position.Y.Offset
                end)
                for _, child in ipairs(frames) do
                    child.Position = UDim2.new(child.Position.X.Scale, child.Position.X.Offset, 0, startY)
                    startY = startY + child.Size.Y.Offset + 10
                end
                tabData.YPosition = startY
                tabData.Frame.CanvasSize = UDim2.new(0, 0, 0, startY + 10)
            end

            function SectionObject:NewButton(buttonName, description, callback)
                local currentY = tabData.YPosition

                local buttonFrame = Instance.new("Frame")
                buttonFrame.Size = UDim2.new(1, 0, 0, 60)
                buttonFrame.Position = UDim2.new(0, 0, 0, currentY)
                buttonFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- Черный фон
                buttonFrame.BorderSizePixel = 1
                buttonFrame.BorderColor3 = CurrentColor -- Цветная обводка
                buttonFrame.Parent = container

                local nameLabel = Instance.new("TextLabel")
                nameLabel.Size = UDim2.new(1, -20, 0, 25)
                nameLabel.Position = UDim2.new(0, 10, 0, 5)
                nameLabel.BackgroundTransparency = 1
                nameLabel.Text = buttonName
                nameLabel.TextColor3 = CurrentColor -- Цветной текст
                nameLabel.TextSize = 16
                nameLabel.Font = Enum.Font.Code
                nameLabel.TextXAlignment = Enum.TextXAlignment.Left
                nameLabel.Parent = buttonFrame

                local descLabel = Instance.new("TextLabel")
                descLabel.Size = UDim2.new(1, -20, 0, 20)
                descLabel.Position = UDim2.new(0, 10, 0, 30)
                descLabel.BackgroundTransparency = 1
                descLabel.Text = description or ""
                descLabel.TextColor3 = Color3.fromRGB(140, 140, 140)
                descLabel.TextSize = 12
                descLabel.Font = Enum.Font.Code
                descLabel.TextXAlignment = Enum.TextXAlignment.Left
                descLabel.Parent = buttonFrame

                local button = Instance.new("TextButton")
                button.Size = UDim2.new(1, 0, 1, 0)
                button.BackgroundTransparency = 1
                button.Text = ""
                button.Parent = buttonFrame

                button.MouseEnter:Connect(function()
                    buttonFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                end)
                button.MouseLeave:Connect(function()
                    buttonFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                end)
                button.MouseButton1Click:Connect(function()
                    buttonFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                    task.wait(0.1)
                    buttonFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    if callback then
                        local success, err = pcall(callback)
                        if not success then
                            warn("Error in button callback: " .. err)
                        end
                    end
                end)

                tabData.YPosition = currentY + 70
                tabData.Frame.CanvasSize = UDim2.new(0, 0, 0, tabData.YPosition + 10)
            end

            function SectionObject:NewToggle(toggleName, description, callback)
                local currentY = tabData.YPosition
                local toggleId = tostring(math.random(10000, 99999))

                local toggleFrame = Instance.new("Frame")
                toggleFrame.Size = UDim2.new(1, 0, 0, 50)
                toggleFrame.Position = UDim2.new(0, 0, 0, currentY)
