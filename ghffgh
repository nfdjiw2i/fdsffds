    local resizing = false
    local minW = 400
    local minH = 250
    local startMousePos = nil
    local startFrameSize = nil
    
    resizeHandle.MouseButton1Down:Connect(function()
        resizing = true
        mainFrame.Draggable = false
        startMousePos = UserInputService:GetMouseLocation()
        startFrameSize = mainFrame.AbsoluteSize
        resizeHandle.BackgroundColor3 = CurrentColor -- Цветной индикатор при ресайзе
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local mousePos = UserInputService:GetMouseLocation()
            local deltaX = mousePos.X - startMousePos.X
            local deltaY = mousePos.Y - startMousePos.Y
            local newW = math.max(minW, startFrameSize.X + deltaX)
            local newH = math.max(minH, startFrameSize.Y + deltaY)
            mainFrame.Size = UDim2.new(0, newW, 0, newH)
            savedSize = Vector2.new(newW, newH)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if resizing then
                resizing = false
                mainFrame.Draggable = true
                resizeHandle.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
            end
        end
    end)

