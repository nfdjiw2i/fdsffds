    local function updateAllAccentColors()
        if UIElements.ActiveLine then
            UIElements.ActiveLine.BackgroundColor3 = CurrentColor
        end
        for _, obj in pairs(mainFrame:GetDescendants()) do
            if obj:IsA("Frame") and obj.BorderSizePixel > 0 and obj ~= closeButton then
                obj.BorderColor3 = CurrentColor -- Цветная обводка для всех рамок
            end
            if obj:IsA("TextButton") and obj.BackgroundColor3 == Color3.fromRGB(0, 0, 0) then
                obj.BorderColor3 = CurrentColor -- Цветная обводка для кнопок
                if obj.TextColor3 ~= Color3.fromRGB(255, 80, 80) then -- Кроме кнопки закрытия
                    obj.TextColor3 = CurrentColor -- Цветной текст
                end
            end
            if obj:IsA("TextLabel") and obj.BackgroundTransparency == 1 then
                obj.TextColor3 = CurrentColor -- Цветной текст для заголовков
            end
            if obj.Name == "sliderFill" or obj.Name == "toggleIndicator" then
                obj.BackgroundColor3 = CurrentColor -- Цветные индикаторы
            end
            if obj.Name == "valueLabel" or obj.Name == "nameLabel" then
                obj.TextColor3 = CurrentColor -- Цветной текст
            end
        end
        -- Обновляем цвет текста в topBar
        titleLabel.TextColor3 = CurrentColor
        minBtnFrame.BorderColor3 = CurrentColor
        minBtnFrame.TextColor3 = CurrentColor
    end

